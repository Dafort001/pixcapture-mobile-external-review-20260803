.DS_Store

# Node local dependencies
backend/node_modules/

# Local env files
backend/.env
backend/.env.local
backend/.env.*.local

# Xcode user-specific state
ios/**/*.xcuserstate
ios/**/*.xcuserdata/
ios/**/xcuserdata/

# Optional third-party Panorama/ArUco artifact. The App Store MVP does not use
# this feature; restore the framework from the external artifact vault only for
# a deliberate Panorama build.
ios/PIXCAPTURE/Vendor/opencv2.xcframework/

# Optional local build output
ios/DerivedData/
build/
builds/
tmp-review/

# Local device/container backups.
# Keep locally: these include future ArUco/OpenCV geometry verification data.
device-backups/
