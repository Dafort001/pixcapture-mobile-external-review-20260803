"help.glossary.item.camera.bracketing.term" = "Belichtungsreihe";
"help.glossary.item.camera.bracketing.desc" = "Mehrere Aufnahmen desselben Motivs mit unterschiedlicher Helligkeit. Daraus kann später ein besser bearbeitbares Bild entstehen.";
"help.glossary.item.camera.ev.term" = "EV";
"help.glossary.item.camera.ev.desc" = "Exposure Value, also Belichtungswert. Ein höherer EV ist heller, ein niedrigerer EV dunkler.";
"help.glossary.item.camera.raw.term" = "RAW / DNG";
"help.glossary.item.camera.raw.desc" = "Originalnahes Kameraformat mit viel Bearbeitungsspielraum. Für PixCapture ist DNG meist der bevorzugte Qualitätsmodus.";
"help.glossary.item.camera.locks.term" = "Fokus- und Belichtungssperre";
"help.glossary.item.camera.locks.desc" = "Fixiert Kameraentscheidungen, damit eine Serie nicht zwischen den Einzelbildern springt.";
"help.glossary.item.camera.wb.term" = "Weißabgleich / Kelvin";
"help.glossary.item.camera.wb.desc" = "Steuert die Farbstimmung. Konstante Werte helfen, dass eine Serie gleichmäßig bleibt.";
"help.glossary.item.camera.overlays.term" = "Overlays";
"help.glossary.item.camera.overlays.desc" = "Hilfen im Sucher wie Raster, Histogramm, Level und Fokusrahmen.";
"help.glossary.item.camera.eq.term" = "Qualitätsanzeige";
"help.glossary.item.camera.eq.desc" = "Statushinweise für Belichtung, Schärfe und Stabilität. Sie sind Hinweise, kein Ersatz für den Blick auf das Motiv.";
"help.glossary.item.camera.remote.term" = "Fernauslöser";
"help.glossary.item.camera.remote.desc" = "Ein externer Auslöser kann Verwacklung reduzieren, besonders bei dunkleren Motiven.";
"help.glossary.item.gallery.series.term" = "Stack";
"help.glossary.item.gallery.series.desc" = "Eine zusammengehörige Gruppe von Dateien für ein Motiv, zum Beispiel 1, 3 oder 5 Belichtungen.";
"help.glossary.item.gallery.roomFloor.term" = "Raum und Etage";
"help.glossary.item.gallery.roomFloor.desc" = "Organisationsdaten für spätere Zuordnung im Web und in der Verarbeitung.";
"help.glossary.item.gallery.job.term" = "Job";
"help.glossary.item.gallery.job.desc" = "Ein Auftrag oder Testbereich, in dem Aufnahmen gesammelt werden.";
"help.glossary.item.gallery.upload.term" = "Upload-Status";
"help.glossary.item.gallery.upload.desc" = "Zeigt, ob Daten lokal, wartend, übertragen, bestätigt oder fehlgeschlagen sind.";
"help.glossary.item.floorplan.scan.term" = "Raumscan";
"help.glossary.item.floorplan.scan.desc" = "Erfassung eines Raums für den Grundriss, meist mit LiDAR und Segmentdaten.";
"help.glossary.item.floorplan.review.term" = "Scan prüfen";
"help.glossary.item.floorplan.review.desc" = "Kontrollschritt nach dem Scan, bevor der Raum in den Grundriss übernommen wird.";
"help.glossary.item.floorplan.composer.term" = "Grundriss-Editor";
"help.glossary.item.floorplan.composer.desc" = "Ansicht zum Zusammensetzen, Verschieben und Ergänzen von Räumen.";
"help.glossary.item.floorplan.doors.term" = "Türen";
"help.glossary.item.floorplan.doors.desc" = "Türöffnungen und Anschlagsrichtungen können für die Lesbarkeit des Grundrisses wichtig sein.";
"help.glossary.item.floorplan.route.term" = "Begehung";
"help.glossary.item.floorplan.route.desc" = "Die Reihenfolge und Verbindung der Räume während des Scans.";
"help.glossary.item.floorplan.export.term" = "Export";
"help.glossary.item.floorplan.export.desc" = "Ausgabe des Grundrisses als Datei für Kontrolle, Web oder weitere Bearbeitung.";
"help.glossary.item.video.main.term" = "Videoaufnahme";
"help.glossary.item.video.main.desc" = "Optionale Aufnahmefunktion für Rundgänge und Bewegungsaufnahmen.";
"help.glossary.item.video.lock.term" = "Video-Lock";
"help.glossary.item.video.lock.desc" = "Fixiert Belichtung, Weißabgleich oder Fokus während einer Videoaufnahme.";
"help.glossary.item.video.framing.term" = "Framing";
"help.glossary.item.video.framing.desc" = "Ausschnitt und Format einer Videoaufnahme.";
"help.glossary.item.video.zoom.term" = "Zoom";
"help.glossary.item.video.zoom.desc" = "Wechsel zwischen Brennweiten oder digitaler Ausschnittsänderung.";
"help.glossary.item.video.review.term" = "Video prüfen";
"help.glossary.item.video.review.desc" = "Sichtung einer Aufnahme, bevor sie final verwendet wird.";
"help.glossary.item.backend.upj.term" = "Manifest / UPJ";
"help.glossary.item.backend.upj.desc" = "Strukturierte Datei, die Bilder, Stacks, Räume, Metadaten und Zuordnung beschreibt.";
"help.glossary.item.backend.storage.term" = "Lokaler Speicher";
"help.glossary.item.backend.storage.desc" = "Bereich auf dem Gerät, in dem Aufnahmen und Begleitdaten bis zum Upload liegen.";

