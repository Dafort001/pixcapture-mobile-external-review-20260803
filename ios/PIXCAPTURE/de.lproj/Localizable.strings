"help.title" = "Hilfe";
"help.card.glossary.title" = "Begriffe & Funktionen";
"help.card.glossary.subtitle" = "Kurze Erklärungen zu Kamera, Galerie, Upload und Grundriss.";
"help.card.forgotPassword.title" = "Passwort vergessen";
"help.card.forgotPassword.subtitle" = "Hinweise zum Zurücksetzen des Passworts.";
"help.card.register.title" = "Neuen Zugang anlegen";
"help.card.register.subtitle" = "Wie ein PixCapture-Konto vorbereitet wird.";
"help.detail.status" = "Status: Diese Hilfe ist lokal in der App verfügbar.";
"help.detail.glossary" = "Das Glossar erklärt die wichtigsten Begriffe der App. Es ist bewusst kurz gehalten, damit Nutzer während eines Shootings schnell nachsehen können.";
"help.detail.forgotPassword" = "Wenn ein Nutzer sein Passwort vergessen hat, soll der Zugang über die Web-App oder den Support zurückgesetzt werden. Die App zeigt hier nur den Einstieg, sie baut keinen eigenen Passwort-Reset-Flow.";
"help.detail.register" = "Neue Nutzer werden über PixCapture freigeschaltet. Auf gemeinsam genutzten Telefonen meldet sich jeder Nutzer mit seinem eigenen Konto an.";
"help.info.scope.title" = "Wofür PixCapture gedacht ist";
"help.info.scope.text" = "PixCapture sammelt Aufnahmen, Raumzuordnung, technische Metadaten und Grundrisse für die spätere Verarbeitung. Exposé, CRM und Kundengalerie bleiben eher im Web.";
"help.info.navigation.title" = "Navigation";
"help.info.navigation.text" = "Unten wechselst du zwischen Start, Sonne, Kamera, Grundriss, Galerie und Mehr. Die Startseite sammelt Konto, Jobs und Hilfe.";
"help.info.cameraTopbar.title" = "Kamera-Kopfzeile";
"help.info.cameraTopbar.text" = "Oben wählst du Job und Raum. Die mittlere Werkzeugtaste öffnet manuelle Kamera-Optionen.";
"help.info.cameraStatus.title" = "Belichtung und Schärfe";
"help.info.cameraStatus.text" = "Die grünen Statuspunkte zeigen, ob Belichtung und Schärfe brauchbar wirken. Bei Gelb oder Rot sollte die Aufnahme geprüft oder wiederholt werden.";
"help.info.manual.title" = "Manuelle Einstellungen";
"help.info.manual.text" = "Unter Mehr oder über das Werkzeug kannst du Kameraoptionen prüfen. Für normale Nutzer soll möglichst wenig manuell verstellt werden müssen.";
"help.info.bracketing.title" = "Belichtungsreihe";
"help.info.bracketing.text" = "1x, 3x oder 5x bedeuten, wie viele Belichtungen zu einem Motiv aufgenommen werden. Ein Motiv wird in der Galerie als Stack zusammengehalten.";
"help.info.raw.title" = "RAW/DNG und JPEG";
"help.info.raw.text" = "RAW/DNG ist für spätere Bearbeitung am wertvollsten. Wenn RAW nicht zuverlässig verfügbar ist, verwendet die App JPEG. HEIF/HEIC wird nicht erzeugt.";
"help.info.roomPicker.title" = "Raum wählen";
"help.info.roomPicker.text" = "Raum und Etage helfen später beim Upload und bei der Web-Kontrolle. Wenn die Etage undefiniert ist, kann die Raumwahl leer wirken.";
"help.info.login.title" = "Anmeldung";
"help.info.login.text" = "Auf gemeinsam genutzten Geräten soll jeder Nutzer mit eigenem Konto arbeiten. Der Accountwechsel läuft über die Login-Seite.";
"help.info.jobs.title" = "Jobs";
"help.info.jobs.text" = "Ein Job bündelt eine Aufnahme-Session. Test-Jobs dürfen leer sein und können gelöscht werden. Ohne Job landen Aufnahmen später in einem Sammelbereich.";
"help.info.upload.title" = "Upload";
"help.info.upload.text" = "Der Upload überträgt komplette Stacks mit Metadaten. Nach erfolgreicher Server-Quittung zeigt die App den Status in der Galerie.";
"help.info.iso.title" = "ISO";
"help.info.iso.text" = "ISO beschreibt die Lichtempfindlichkeit. Sehr hohe ISO-Werte können Bildrauschen erzeugen.";
"help.info.ev.title" = "EV";
"help.info.ev.text" = "EV steht für Belichtungswert. Bei Belichtungsreihen liegen mehrere Bilder mit unterschiedlichen Helligkeiten im selben Stack.";
"help.info.histogram.title" = "Histogramm";
"help.info.histogram.text" = "Das Histogramm zeigt die Helligkeitsverteilung. Es hilft zu erkennen, ob ein Bild sehr dunkel oder stark ausgefressen ist.";
"help.info.level.title" = "Ausrichtung";
"help.info.level.text" = "Die Level-Anzeige hilft, das Telefon gerade zu halten. Gerade Linien sind für Immobilienfotos und Grundrissbezüge wichtig.";
"help.info.focus.title" = "Fokus";
"help.info.focus.text" = "Die Schärfe sollte auf dem Hauptmotiv liegen. Wenn der Fokus unsicher ist, lieber kurz neu auslösen.";
"help.info.taxonomy.title" = "Taxonomie";
"help.info.taxonomy.text" = "Raum, Etage und Motivnummer sind Organisationsdaten. Sie sollen für den ganzen Stack gelten, nicht nur für ein einzelnes Vorschaubild.";
"help.info.formats.title" = "Dateien und Stacks";
"help.info.formats.text" = "Ein sichtbares Bild kann stellvertretend für mehrere Originaldateien stehen. Entscheidend sind Stack, Originale und Manifest zusammen.";
"help.glossary.heading" = "Glossar";
"help.glossary.searchHint.video" = "Suche nach Kamera-, Upload-, Grundriss- oder Video-Begriffen.";
"help.glossary.searchHint" = "Suche nach Kamera-, Upload- oder Grundriss-Begriffen.";
"help.glossary.searchPlaceholder" = "Begriff suchen";
