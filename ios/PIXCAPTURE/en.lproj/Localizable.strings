"help.title" = "Help";
"help.card.glossary.title" = "Terms & Features";
"help.card.glossary.subtitle" = "Short explanations for camera, gallery, upload and floorplan.";
"help.card.forgotPassword.title" = "Forgot Password";
"help.card.forgotPassword.subtitle" = "How password reset should be handled.";
"help.card.register.title" = "Create New Access";
"help.card.register.subtitle" = "How a PixCapture account is prepared.";
"help.detail.status" = "Status: This help is available locally in the app.";
"help.detail.glossary" = "The glossary explains the most important terms in the app. It is intentionally short so users can check it quickly during a shoot.";
"help.detail.forgotPassword" = "If a user forgot their password, access should be reset through the web app or support. The app only provides the entry point here and does not build its own password reset flow.";
"help.detail.register" = "New users are enabled through PixCapture. On shared phones, each user signs in with their own account.";
"help.info.scope.title" = "What PixCapture is for";
"help.info.scope.text" = "PixCapture collects captures, room assignment, technical metadata and floorplans for later processing. Expose, CRM and client galleries mostly stay in the web product.";
"help.info.navigation.title" = "Navigation";
"help.info.navigation.text" = "Use the bottom bar to switch between Start, Sun, Camera, Floorplan, Gallery and More. Start collects account, jobs and help.";
"help.info.cameraTopbar.title" = "Camera Header";
"help.info.cameraTopbar.text" = "At the top you choose job and room. The centered tool button opens manual camera options.";
"help.info.cameraStatus.title" = "Exposure and Focus";
"help.info.cameraStatus.text" = "The green status dots indicate whether exposure and focus look usable. Yellow or red means the capture should be checked or repeated.";
"help.info.manual.title" = "Manual Settings";
"help.info.manual.text" = "Use More or the tool button to check camera options. Normal users should need as little manual adjustment as possible.";
"help.info.bracketing.title" = "Bracketing";
"help.info.bracketing.text" = "1x, 3x or 5x describes how many exposures are captured for one motif. The gallery keeps one motif together as a stack.";
"help.info.raw.title" = "RAW/DNG and JPEG";
"help.info.raw.text" = "RAW/DNG is most valuable for later editing. If RAW is not reliably available, the app uses JPEG. HEIF/HEIC is not created.";
"help.info.roomPicker.title" = "Choose Room";
"help.info.roomPicker.text" = "Room and floor help later during upload and web review. If the floor is undefined, room selection can appear empty.";
"help.info.login.title" = "Sign In";
"help.info.login.text" = "On shared devices, each user should work with their own account. Account switching happens through the login page.";
"help.info.jobs.title" = "Jobs";
"help.info.jobs.text" = "A job groups one capture session. Test jobs may be empty and can be deleted. Without a job, captures later go into a collection bucket.";
"help.info.upload.title" = "Upload";
"help.info.upload.text" = "Upload transfers complete stacks with metadata. After server confirmation, the app shows the status in the gallery.";
"help.info.iso.title" = "ISO";
"help.info.iso.text" = "ISO describes light sensitivity. Very high ISO values can create visible image noise.";
"help.info.ev.title" = "EV";
"help.info.ev.text" = "EV means exposure value. Bracketed stacks contain several images with different brightness values.";
"help.info.histogram.title" = "Histogram";
"help.info.histogram.text" = "The histogram shows brightness distribution. It helps detect very dark or strongly clipped images.";
"help.info.level.title" = "Level";
"help.info.level.text" = "The level indicator helps keep the phone straight. Straight lines matter for real estate images and floorplan context.";
"help.info.focus.title" = "Focus";
"help.info.focus.text" = "Focus should sit on the main subject. If focus looks uncertain, capture again.";
"help.info.taxonomy.title" = "Taxonomy";
"help.info.taxonomy.text" = "Room, floor and motif number are organization data. They should apply to the whole stack, not just one preview image.";
"help.info.formats.title" = "Files and Stacks";
