"help.title" = "Help";
"help.card.glossary.title" = "Terms & Features";
"help.card.glossary.subtitle" = "Short explanations for camera, gallery, upload and floorplan.";
"help.card.forgotPassword.title" = "Forgot Password";
"help.card.forgotPassword.subtitle" = "How password reset should be handled.";
"help.card.register.title" = "Create New Access";
"help.card.register.subtitle" = "How a PixCapture account is prepared.";
"help.detail.status" = "Status: This help is available locally in the app.";
"help.detail.glossary" = "The glossary explains the most important terms in the app. It is intentionally short so users can check it quickly during a shoot.";
"help.detail.forgotPassword" = "If a user forgot their password, access should be reset through the web app or support. The app only provides the entry point here and does not build its own password reset flow.";
"help.detail.register" = "New users are enabled through PixCapture. On shared phones, each user signs in with their own account.";
"help.info.scope.title" = "What PixCapture is for";
"help.info.scope.text" = "PixCapture collects captures, room assignment, technical metadata and floorplans for later processing. Expose, CRM and client galleries mostly stay in the web product.";
"help.info.navigation.title" = "Navigation";
"help.info.navigation.text" = "Use the bottom bar to switch between Start, Sun, Camera, Floorplan, Gallery and More. Start collects account, jobs and help.";
"help.info.cameraTopbar.title" = "Camera Header";
"help.info.cameraTopbar.text" = "At the top you choose job and room. The centered tool button opens manual camera options.";
"help.info.cameraStatus.title" = "Exposure and Focus";
"help.info.cameraStatus.text" = "The green status dots indicate whether exposure and focus look usable. Yellow or red means the capture should be checked or repeated.";
"help.info.manual.title" = "Manual Settings";
"help.info.manual.text" = "Use More or the tool button to check camera options. Normal users should need as little manual adjustment as possible.";
"help.info.bracketing.title" = "Bracketing";
"help.info.bracketing.text" = "1x, 3x or 5x describes how many exposures are captured for one motif. The gallery keeps one motif together as a stack.";
"help.info.raw.title" = "RAW/DNG and JPEG";
"help.info.raw.text" = "RAW/DNG is most valuable for later editing. If RAW is not reliably available, the app uses JPEG. HEIF/HEIC is not created.";
"help.info.roomPicker.title" = "Choose Room";
"help.info.roomPicker.text" = "Room and floor help later during upload and web review. If the floor is undefined, room selection can appear empty.";
"help.info.login.title" = "Sign In";
"help.info.login.text" = "On shared devices, each user should work with their own account. Account switching happens through the login page.";
"help.info.jobs.title" = "Jobs";
"help.info.jobs.text" = "A job groups one capture session. Test jobs may be empty and can be deleted. Without a job, captures later go into a collection bucket.";
"help.info.upload.title" = "Upload";
"help.info.upload.text" = "Upload transfers complete stacks with metadata. After server confirmation, the app shows the status in the gallery.";
"help.info.iso.title" = "ISO";
"help.info.iso.text" = "ISO describes light sensitivity. Very high ISO values can create visible image noise.";
"help.info.ev.title" = "EV";
"help.info.ev.text" = "EV means exposure value. Bracketed stacks contain several images with different brightness values.";
"help.info.histogram.title" = "Histogram";
"help.info.histogram.text" = "The histogram shows brightness distribution. It helps detect very dark or strongly clipped images.";
"help.info.level.title" = "Level";
"help.info.level.text" = "The level indicator helps keep the phone straight. Straight lines matter for real estate images and floorplan context.";
"help.info.focus.title" = "Focus";
"help.info.focus.text" = "Focus should sit on the main subject. If focus looks uncertain, capture again.";
"help.info.taxonomy.title" = "Taxonomy";
"help.info.taxonomy.text" = "Room, floor and motif number are organization data. They should apply to the whole stack, not just one preview image.";
"help.info.formats.title" = "Files and Stacks";
"help.info.formats.text" = "One visible image can stand in for several original files. What matters is the stack, originals and manifest together.";
"help.glossary.heading" = "Glossary";
"help.glossary.searchHint.video" = "Search camera, upload, floorplan or video terms.";
"help.glossary.searchHint" = "Search camera, upload or floorplan terms.";
"help.glossary.searchPlaceholder" = "Search term";
"help.glossary.category.camera" = "Camera";
"help.glossary.category.galleryUpload" = "Gallery & Upload";
"help.glossary.category.floorplan" = "Floorplan";
"help.glossary.category.video" = "Video";
"help.glossary.category.backend" = "Data & Processing";
"help.glossary.item.camera.bracketing.term" = "Bracketing";
"help.glossary.item.camera.bracketing.desc" = "Several captures of the same motif with different brightness values. Later this can produce a more editable image.";
"help.glossary.item.camera.ev.term" = "EV";
"help.glossary.item.camera.ev.desc" = "Exposure value. A higher EV is brighter, a lower EV is darker.";
"help.glossary.item.camera.raw.term" = "RAW / DNG";
"help.glossary.item.camera.raw.desc" = "Near-original camera format with broad editing latitude. DNG is usually the preferred quality mode for PixCapture.";
"help.glossary.item.camera.locks.term" = "Focus and Exposure Lock";
"help.glossary.item.camera.locks.desc" = "Fixes camera decisions so a series does not shift between individual frames.";
"help.glossary.item.camera.wb.term" = "White Balance / Kelvin";
"help.glossary.item.camera.wb.desc" = "Controls color temperature. Stable values help keep a series consistent.";
"help.glossary.item.camera.overlays.term" = "Overlays";
"help.glossary.item.camera.overlays.desc" = "Viewfinder aids such as grid, histogram, level and focus frame.";
"help.glossary.item.camera.eq.term" = "Quality Indicator";
"help.glossary.item.camera.eq.desc" = "Status hints for exposure, focus and stability. They are hints, not a replacement for looking at the motif.";
"help.glossary.item.camera.remote.term" = "Remote Trigger";
"help.glossary.item.camera.remote.desc" = "An external trigger can reduce shake, especially in darker scenes.";
"help.glossary.item.gallery.series.term" = "Stack";
"help.glossary.item.gallery.series.desc" = "A group of files belonging to one motif, for example 1, 3 or 5 exposures.";
"help.glossary.item.gallery.roomFloor.term" = "Room and Floor";
"help.glossary.item.gallery.roomFloor.desc" = "Organization data for later assignment in the web app and processing.";
"help.glossary.item.gallery.job.term" = "Job";
"help.glossary.item.gallery.job.desc" = "An assignment or test area where captures are collected.";
"help.glossary.item.gallery.upload.term" = "Upload Status";
"help.glossary.item.gallery.upload.desc" = "Shows whether data is local, waiting, transferred, confirmed or failed.";
"help.glossary.item.floorplan.scan.term" = "Room Scan";
"help.glossary.item.floorplan.scan.desc" = "Capturing a room for the floorplan, usually with LiDAR and segment data.";
"help.glossary.item.floorplan.review.term" = "Review Scan";
"help.glossary.item.floorplan.review.desc" = "Check step after scanning before the room is added to the floorplan.";
"help.glossary.item.floorplan.composer.term" = "Floorplan Editor";
"help.glossary.item.floorplan.composer.desc" = "View for combining, moving and adding rooms.";
"help.glossary.item.floorplan.doors.term" = "Doors";
"help.glossary.item.floorplan.doors.desc" = "Door openings and swing direction can matter for floorplan readability.";
"help.glossary.item.floorplan.route.term" = "Walkthrough";
"help.glossary.item.floorplan.route.desc" = "The order and connection of rooms during scanning.";
"help.glossary.item.floorplan.export.term" = "Export";
"help.glossary.item.floorplan.export.desc" = "Output of the floorplan as a file for review, web or further editing.";
"help.glossary.item.video.main.term" = "Video Capture";
"help.glossary.item.video.main.desc" = "Optional capture feature for walkthroughs and moving shots.";
"help.glossary.item.video.lock.term" = "Video Lock";
"help.glossary.item.video.lock.desc" = "Fixes exposure, white balance or focus during a video capture.";
"help.glossary.item.video.framing.term" = "Framing";
"help.glossary.item.video.framing.desc" = "Crop and format of a video capture.";
"help.glossary.item.video.zoom.term" = "Zoom";
"help.glossary.item.video.zoom.desc" = "Switching focal lengths or changing the digital crop.";
"help.glossary.item.video.review.term" = "Review Video";
"help.glossary.item.video.review.desc" = "Checking a capture before final use.";
"help.glossary.item.backend.upj.term" = "Manifest / UPJ";
"help.glossary.item.backend.upj.desc" = "Structured file describing images, stacks, rooms, metadata and assignment.";
"help.glossary.item.backend.storage.term" = "Local Storage";
"help.glossary.item.backend.storage.desc" = "Area on the device where captures and sidecar data live until upload.";

