"help.glossary.item.camera.bracketing.term" = "Bracketing";
"help.glossary.item.camera.bracketing.desc" = "Several captures of the same motif with different brightness values. Later this can produce a more editable image.";
"help.glossary.item.camera.ev.term" = "EV";
"help.glossary.item.camera.ev.desc" = "Exposure value. A higher EV is brighter, a lower EV is darker.";
"help.glossary.item.camera.raw.term" = "RAW / DNG";
"help.glossary.item.camera.raw.desc" = "Near-original camera format with broad editing latitude. DNG is usually the preferred quality mode for PixCapture.";
"help.glossary.item.camera.locks.term" = "Focus and Exposure Lock";
"help.glossary.item.camera.locks.desc" = "Fixes camera decisions so a series does not shift between individual frames.";
"help.glossary.item.camera.wb.term" = "White Balance / Kelvin";
"help.glossary.item.camera.wb.desc" = "Controls color temperature. Stable values help keep a series consistent.";
"help.glossary.item.camera.overlays.term" = "Overlays";
"help.glossary.item.camera.overlays.desc" = "Viewfinder aids such as grid, histogram, level and focus frame.";
"help.glossary.item.camera.eq.term" = "Quality Indicator";
"help.glossary.item.camera.eq.desc" = "Status hints for exposure, focus and stability. They are hints, not a replacement for looking at the motif.";
"help.glossary.item.camera.remote.term" = "Remote Trigger";
"help.glossary.item.camera.remote.desc" = "An external trigger can reduce shake, especially in darker scenes.";
"help.glossary.item.gallery.series.term" = "Stack";
"help.glossary.item.gallery.series.desc" = "A group of files belonging to one motif, for example 1, 3 or 5 exposures.";
"help.glossary.item.gallery.roomFloor.term" = "Room and Floor";
"help.glossary.item.gallery.roomFloor.desc" = "Organization data for later assignment in the web app and processing.";
"help.glossary.item.gallery.job.term" = "Job";
"help.glossary.item.gallery.job.desc" = "An assignment or test area where captures are collected.";
"help.glossary.item.gallery.upload.term" = "Upload Status";
"help.glossary.item.gallery.upload.desc" = "Shows whether data is local, waiting, transferred, confirmed or failed.";
"help.glossary.item.floorplan.scan.term" = "Room Scan";
"help.glossary.item.floorplan.scan.desc" = "Capturing a room for the floorplan, usually with LiDAR and segment data.";
"help.glossary.item.floorplan.review.term" = "Review Scan";
"help.glossary.item.floorplan.review.desc" = "Check step after scanning before the room is added to the floorplan.";
"help.glossary.item.floorplan.composer.term" = "Floorplan Editor";
"help.glossary.item.floorplan.composer.desc" = "View for combining, moving and adding rooms.";
"help.glossary.item.floorplan.doors.term" = "Doors";
"help.glossary.item.floorplan.doors.desc" = "Door openings and swing direction can matter for floorplan readability.";
"help.glossary.item.floorplan.route.term" = "Walkthrough";
"help.glossary.item.floorplan.route.desc" = "The order and connection of rooms during scanning.";
"help.glossary.item.floorplan.export.term" = "Export";
"help.glossary.item.floorplan.export.desc" = "Output of the floorplan as a file for review, web or further editing.";
"help.glossary.item.video.main.term" = "Video Capture";
"help.glossary.item.video.main.desc" = "Optional capture feature for walkthroughs and moving shots.";
"help.glossary.item.video.lock.term" = "Video Lock";
"help.glossary.item.video.lock.desc" = "Fixes exposure, white balance or focus during a video capture.";
"help.glossary.item.video.framing.term" = "Framing";
"help.glossary.item.video.framing.desc" = "Crop and format of a video capture.";
"help.glossary.item.video.zoom.term" = "Zoom";
"help.glossary.item.video.zoom.desc" = "Switching focal lengths or changing the digital crop.";
"help.glossary.item.video.review.term" = "Review Video";
"help.glossary.item.video.review.desc" = "Checking a capture before final use.";
"help.glossary.item.backend.upj.term" = "Manifest / UPJ";
"help.glossary.item.backend.upj.desc" = "Structured file describing images, stacks, rooms, metadata and assignment.";
"help.glossary.item.backend.storage.term" = "Local Storage";
"help.glossary.item.backend.storage.desc" = "Area on the device where captures and sidecar data live until upload.";

